    {
      "parameters": {
        "jsCode": "const html = $json.data || '';\n\n// Try the real og:image meta tag first\nconst ogMatch = html.match(/<meta[^>]+property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i);\nlet image = ogMatch ? ogMatch[1] : null;\n\n// Some sites reverse attribute order (content before property)\nif (!image) {\n  const ogMatchAlt = html.match(/<meta[^>]+content=[\"']([^\"']+)[\"'][^>]+property=[\"']og:image[\"']/i);\n  image = ogMatchAlt ? ogMatchAlt[1] : null;\n}\n\n// Fallback to whatever the earlier Jina-based extraction found\nif (!image) {\n  image = $('Code in JavaScript').item.json.image || null;\n}\n\nreturn [{\n  json: {\n    ...$('Code in JavaScript').item.json,\n    image\n  }\n}];"
      },
