      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.processedUrls = staticData.processedUrls || [];\n\nconst items = $input.all();\nlet selectedItem = null;\n\n// Find the first article we haven't processed yet\nfor (const item of items) {\n  const url = item.json.link;\n  if (!staticData.processedUrls.includes(url)) {\n    selectedItem = item;\n    break;\n  }\n}\n\nif (!selectedItem) {\n  return []; // Stop execution if no new news\n}\n\nreturn [selectedItem];"
      },
