      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || $json.post || '';\n\nconst cleaned = raw\n  .replace(/\\\\\\\\n/g, '\\n')\n  .replace(/\\\\n/g, '\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nconst link = $('If').item.json.link;\nconst post = `${cleaned}\\n\\n${link}`;\n\nreturn [{\n  json: {\n    post,\n    link,\n    image: $('If').item.json.image\n  }\n}];"
