        "jsCode": "const raw = $json.output || \"\";\nconst cleaned = raw\n  .replace(/^json\\s*/i, \"\")\n  .replace(/```json|```/g, \"\")\n  .trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { score: 0, hooks: [], post: raw };\n}\nreturn [{\n  json: {\n    ...$json,\n    ...parsed,\n    link: $('OG Image').item.json.link,\n    image: $('OG Image').item.json.image\n  }\n}];"
