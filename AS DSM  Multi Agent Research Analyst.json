        0
      ],
      "id": "723dad5d-7bd7-40db-8d23-858591284f37",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of items) {\n  let raw = item.output || item.json?.output || item;\n\n  if (!raw || typeof raw !== 'string') {\n    results.push({\n      json: {\n        answer: \"Failed to parse output.\",\n        proceed: \"No\",\n        researchA: \"\",\n        researchB: \"\"\n      }\n    });\n    continue;\n  }\n\n  let parsed = null;\n\n  try {\n    // Attempt direct parse\n    parsed = JSON.parse(raw);\n  } catch (e1) {\n    try {\n      // Try parsing from ```json code block\n      const codeBlockRegex = /```(?:json)?\\s*([\\s\\S]*?)\\s*```/g;\n      const matches = [...raw.matchAll(codeBlockRegex)];\n      for (const match of matches) {\n        try {\n          parsed = JSON.parse(match[1].trim());\n          break;\n        } catch (e2) {}\n      }\n\n      // Fallback: parse from within raw JSON-looking content\n      if (!parsed) {\n        const jsonStart = raw.indexOf('{');\n        const jsonEnd = raw.lastIndexOf('}');\n        if (jsonStart !== -1 && jsonEnd !== -1) {\n          parsed = JSON.parse(raw.substring(jsonStart, jsonEnd + 1));\n        }\n      }\n    } catch (e3) {}\n  }\n\n  // Handle double-encoded JSON\n  if (parsed && typeof parsed === 'string') {\n    try {\n      parsed = JSON.parse(parsed);\n    } catch (e) {}\n  }\n\n  const answer = parsed?.answer || parsed?.response || parsed?.reply || raw.trim();\n  const proceedValue = (parsed?.proceed || \"\").trim().toLowerCase() === \"yes\" ? \"Yes\" : \"No\";\n\n  results.push({\n    json: {\n      answer,\n      proceed: proceedValue,\n      researchA: parsed?.researchA || \"\",\n      researchB: parsed?.researchB || \"\"\n    }\n  });\n}\n\nreturn results;"
      },
